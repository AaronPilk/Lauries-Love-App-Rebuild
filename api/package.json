{
  "name": "laurieslove",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --force-exit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js -d ./data-source.ts",
    "typeorm:sync": "npm run typeorm -- schema:sync",
    "typeorm:drop": "npm run typeorm -- schema:drop",
    "typeorm:reset": "npm run typeorm:drop && npm run typeorm:sync",
    "typeorm:migrate": "npm run typeorm migration:generate ./libs/database/migrations/tables -d ./data-source.ts",
    "typeorm:generate": "npm run typeorm migration:generate libs/database/src/migrations/Migration --timestamp ",
    "typeorm:revert": "npm run typeorm migration:revert",
    "db:seed": "ts-node ./node_modules/typeorm-seeding/dist/cli.js seed",
    "db:create": "ts-node ./node_modules/typeorm-extension/dist/cli/index.js db:create",
    "db:drop": "ts-node ./node_modules/typeorm-extension/dist/cli/index.js db:drop",
    "migrations:run": "npm run typeorm -- migration:run && npm run seed:run",
    "seed:run": "ts-node ./node_modules/typeorm-extension/bin/cli.cjs seed:run",
    "seed:config": "ts-node ./node_modules/typeorm-extension/bin/cli.cjs config"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.744.0",
    "@aws-sdk/s3-request-presigner": "^3.691.0",
    "@dataui/crud": "^5.3.4",
    "@dataui/crud-typeorm": "^5.3.4",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.16",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.16",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.16",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sentry/cli": "^2.38.2",
    "@sentry/nestjs": "^9.13.0",
    "@sentry/profiling-node": "^9.13.0",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.13",
    "authorizenet": "^1.0.9",
    "aws-sdk": "^2.1692.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "express-useragent": "^1.0.15",
    "firebase-admin": "^12.7.0",
    "form-data": "^4.0.1",
    "jest-environment-node": "^29.7.0",
    "jest-regex-util": "^29.6.3",
    "jwks-rsa": "^3.1.0",
    "lodash": "^4.17.21",
    "mime-types": "^2.1.35",
    "moment": "^2.30.1",
    "multer": "^2.0.1",
    "mysql2": "^3.11.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.24",
    "typeorm-extension": "^3.7.1",
    "typeorm-naming-strategies": "^4.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.0.0",
    "@types/authorizenet": "^1.0.2",
    "@types/cron": "^2.4.3",
    "@types/express": "^5.0.0",
    "@types/jest": "29.5.14",
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.9.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "jest": "29.7.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.6.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/shufflrr(|/.*)$": "<rootDir>/libs/shufflrr/src/$1",
      "^@app/share-point(|/.*)$": "<rootDir>/libs/share-point/src/$1",
      "^@app/database(|/.*)$": "<rootDir>/libs/database/src/$1",
      "^@app/one-drive(|/.*)$": "<rootDir>/libs/one-drive/src/$1",
      "^@app/dropbox(|/.*)$": "<rootDir>/libs/dropbox/src/$1",
      "^@app/google-drive(|/.*)$": "<rootDir>/libs/google-drive/src/$1",
      "^@app/auth(|/.*)$": "<rootDir>/libs/auth/src/$1"
    }
  }
}
