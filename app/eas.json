{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "channel": "production",
      "environment": "production",
      "android": {
        "resourceClass": "large"
      }
    },
    "staging": {
      "environment": "development",
      "distribution": "internal",
      "android": {
        "resourceClass": "large",
        "buildType": "apk"
      },
      "ios": {
        "resourceClass": "large"
      }
    }
  }
}
