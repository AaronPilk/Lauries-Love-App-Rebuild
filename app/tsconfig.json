{
  "extends": "@tsconfig/react-native/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "jsx": "react",
    "types": ["jest", "node"],
    "typeRoots": ["@types", "./node_modules/@types"],
    "baseUrl": "./src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./"],
      "presentation/*": ["./presentation/*"],
      "types/*": ["../@types/*"],
      "domain/*": ["./domain/*"],
      "infra/*": ["./infra/*"],
      "main/*": ["./main/*"],
      "data/*": ["./data/*"],
      "assets/*": ["./assets/*"],
      "utils/*": ["./utils/*"],
      "components/*": ["./components/*"]
    },
    /* Completeness */
    "skipLibCheck": true /* Skip type checking all .d.ts files. */
  }
}
